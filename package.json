{
  "name": "warshard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "protocol": "node scripts/protocol.mjs",
    "check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && node scripts/protocol.mjs --check && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@types/node": "^24.0.0"
  }
}
